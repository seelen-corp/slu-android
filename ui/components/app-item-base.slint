import { I18n } from "../i18n.slint";
import { AppActions, HomeActions, Interaction, LauncherActions } from "../app-actions.slint";
import { AppItem, FolderItem, PictureItem } from "../types.slint";
import { MenuSurface, MenuItem } from "menu.slint";

// Behaviour shared by every Home/app entry (list row, grid cell, Home cell): tap
// opens the app (or the folder; a picture does nothing); a long press "lifts" it (haptic tick) and, for
// `draggable` entries (on Home), starts dragging it right away. Releasing a
// lifted entry shows its menu, unless it was moved beyond the tap slop: then
// it's dropped instead. The visuals are the children.
export component AppItemBase inherits Rectangle {
    in property <AppItem> app;
    // A folder of Home instead of an app (`folder`); tapping it `open-folder`.
    in property <bool> is-folder: false;
    in property <FolderItem> folder;
    // A picture of Home instead of an app (`picture`); its menu offers
    // `resize-picture` and removing it.
    in property <bool> is-picture: false;
    in property <PictureItem> picture;
    // Entry shown on Home (vs. the Apps Menu); decides the menu actions.
    in property <bool> on-home: false;
    // App shown inside a folder of Home.
    in property <bool> in-folder: false;
    // Home screen enabled in Settings, so apps can be placed on it.
    in property <bool> home-enabled: false;
    in property <bool> draggable: false;
    // A folder of the Home grid (not the dock or the list views): its menu can
    // enlarge it to 2x2 cells or shrink it back.
    in property <bool> resizable-folder: false;
    // A large folder of Home: tapping one of its app icons launches that app
    // (`folder-app-at`); tapping anywhere else opens the folder.
    in property <bool> folder-apps-clickable: false;
    // Shows its notification badge (Home and its folders).
    in property <bool> show-badge: false;
    // A widget of Home: the touches on it are forwarded (`touch-forwarded`)
    // until the long press lifts it, then cancelled.
    in property <bool> forwards-touch: false;

    // An app (not a folder or a picture).
    property <bool> is-app: !root.is-folder && !root.is-picture;
    // Title shown: the app's, or the folder's (its default if it has none).
    out property <string> title: !root.is-folder ? root.app.title
        : root.folder.title != "" ? root.folder.title : I18n.t("home.folder");
    // Number on its badge (0: no badge): the app's notifications, or the ones of
    // all the apps of the folder.
    out property <int> badge-count: !root.show-badge || root.is-picture ? 0
        : root.is-folder ? root.folder.notifications : root.app.notifications;
    // Touch is down on the entry (for the pressed overlay).
    out property <bool> pressed: touch.pressed;
    // A long press was recognized and the touch is still down.
    out property <bool> lifted: touch.pressed && root.long-pressed;
    // Being dragged: from the long press until it's released.
    out property <bool> dragging: false;
    // Moved beyond the tap slop while dragging: releasing drops it (no menu).
    out property <bool> dragged: false;

    callback open-folder();
    // With `folder-apps-clickable`, set by the visuals: index of the folder app
    // whose icon is at a window position, or -1.
    pure callback folder-app-at(x: length, y: length) -> int;
    // "Resize" of a picture's menu.
    callback resize-picture();
    // With `forwards-touch`: a `MotionEvent` action (0 down, 1 up, 2 move,
    // 3 cancel) at a position of the entry.
    callback touch-forwarded(action: int, x: length, y: length);
    // Drag of a `draggable` entry. Positions are in window coordinates.
    // Started by the long press.
    callback drag-started(x: length, y: length);
    // It moved beyond the tap slop (`dragged`): it will be dropped.
    callback drag-confirmed();
    callback drag-moved(x: length, y: length);
    // Released after `drag-confirmed`: drop it there.
    callback drag-ended(x: length, y: length);
    // Released without moving (its menu opens instead), or the touch was lost
    // before: nothing moves.
    callback drag-cancelled();

    // Set by the long press until the next touch, so releasing doesn't also open the app.
    private property <bool> long-pressed: false;
    // Moved beyond the tap slop before the long press: it's a scroll/swipe, not a press.
    private property <bool> moved-away: false;
    private property <length> slop: 8px;
    private property <length> pointer-x: root.absolute-position.x + touch.mouse-x;
    private property <length> pointer-y: root.absolute-position.y + touch.mouse-y;

    // With `folder-apps-clickable`: the folder app whose icon is being pressed
    // (-1: none, or it's not a tap anymore), for its pressed overlay.
    out property <int> pressed-folder-app: root.folder-apps-clickable && touch.pressed && !root.long-pressed && !root.moved-away
        ? root.folder-app-at(root.pointer-x, root.pointer-y) : -1;

    function activate() {
        if root.is-folder {
            let index = root.folder-apps-clickable ? root.folder-app-at(root.pointer-x, root.pointer-y) : -1;
            if index >= 0 {
                AppActions.launch(root.folder.apps[index]);
            } else {
                root.open-folder();
            }
        } else if !root.is-picture {
            AppActions.launch(root.app);
        }
    }

    @children

    touch := TouchArea {
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.long-pressed = false;
                root.moved-away = false;
                root.dragging = false;
                root.dragged = false;
                if root.forwards-touch {
                    Interaction.widget-pressed = true;
                    root.touch-forwarded(0, self.mouse-x, self.mouse-y);
                }
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                // After a long press the widget already got a cancel.
                if root.forwards-touch && !root.long-pressed {
                    root.touch-forwarded(event.kind == PointerEventKind.up ? 1 : 3, self.mouse-x, self.mouse-y);
                }
                if root.forwards-touch {
                    Interaction.widget-pressed = false;
                }
                if root.dragging && root.dragged {
                    root.drag-ended(root.pointer-x, root.pointer-y);
                } else if root.dragging {
                    root.drag-cancelled();
                }
                let show-menu = root.long-pressed && !root.dragged && event.kind == PointerEventKind.up;
                root.dragging = false;
                root.dragged = false;
                if show-menu {
                    menu.show();
                }
                Interaction.item-lifted = false;
            }
        }

        moved => {
            let far = abs(self.mouse-x - self.pressed-x) > root.slop || abs(self.mouse-y - self.pressed-y) > root.slop;
            if root.forwards-touch && !root.long-pressed {
                root.touch-forwarded(2, self.mouse-x, self.mouse-y);
            }
            if !root.long-pressed {
                if far {
                    root.moved-away = true;
                }
                return;
            }
            // No haptic here: the long press tick already says both "release for
            // the menu" and "move to drag it".
            if root.dragging && !root.dragged && far {
                root.dragged = true;
                root.drag-confirmed();
            }
            if root.dragging {
                root.drag-moved(root.pointer-x, root.pointer-y);
            }
        }

        clicked => {
            if !root.long-pressed {
                root.activate();
            }
        }
    }

    Timer {
        interval: 500ms;
        running: touch.pressed && !root.long-pressed && !root.moved-away;
        triggered => {
            root.long-pressed = true;
            // From now on this entry owns the touch (no page/list swipes), and
            // a widget doesn't get it anymore.
            Interaction.item-lifted = true;
            if root.forwards-touch {
                root.touch-forwarded(3, touch.mouse-x, touch.mouse-y);
            }
            LauncherActions.haptic();
            // The menu is ready and, together with it, the drag.
            if root.draggable {
                root.dragging = true;
                root.drag-started(root.pointer-x, root.pointer-y);
            }
        }
    }

    menu := PopupWindow {
        x: touch.pressed-x;
        y: touch.pressed-y;

        MenuSurface {
            min-width: 200px;

            // The folders' actions; the pictures' two; the others are the app's.
            if root.is-folder && root.resizable-folder && !root.folder.large && HomeActions.can-resize-folder(root.folder.id, true): MenuItem {
                text: I18n.t("home.enlarge_folder");
                icon: @image-url("../icons/IoExpandOutline.svg");
                activated => {
                    HomeActions.resize-folder(root.folder.id, true);
                    menu.close();
                }
            }
            if root.is-folder && root.resizable-folder && root.folder.large: MenuItem {
                text: I18n.t("home.shrink_folder");
                icon: @image-url("../icons/IoContractOutline.svg");
                activated => {
                    HomeActions.resize-folder(root.folder.id, false);
                    menu.close();
                }
            }
            if root.is-folder: MenuItem {
                text: I18n.t("home.disband_folder");
                icon: @image-url("../icons/IoFolderOpenOutline.svg");
                activated => {
                    HomeActions.disband-folder(root.folder.id);
                    menu.close();
                }
            }
            if root.is-picture: MenuItem {
                text: I18n.t("home.resize_picture");
                icon: @image-url("../icons/IoResizeOutline.svg");
                activated => {
                    root.resize-picture();
                    menu.close();
                }
            }
            if root.is-picture: MenuItem {
                text: root.picture.widget ? I18n.t("home.remove_widget") : I18n.t("home.delete_picture");
                icon: @image-url("../icons/IoTrashOutline.svg");
                activated => {
                    HomeActions.remove-picture(root.picture);
                    menu.close();
                }
            }
            if !root.on-home && root.home-enabled && !root.app.pinned: MenuItem {
                text: I18n.t("app_actions.add_to_home");
                icon: @image-url("../icons/IoAddCircleOutline.svg");
                activated => {
                    AppActions.add-to-home(root.app);
                    menu.close();
                }
            }
            if root.in-folder: MenuItem {
                text: I18n.t("app_actions.remove_from_folder");
                icon: @image-url("../icons/IoExitOutline.svg");
                activated => {
                    AppActions.remove-from-folder(root.app);
                    menu.close();
                }
            }
            if root.on-home && root.is-app: MenuItem {
                text: I18n.t("app_actions.remove_from_home");
                icon: @image-url("../icons/IoRemoveCircleOutline.svg");
                activated => {
                    AppActions.remove-from-home(root.app);
                    menu.close();
                }
            }
            if root.is-app: MenuItem {
                text: I18n.t("app_actions.app_info");
                icon: @image-url("../icons/IoInformationCircleOutline.svg");
                activated => {
                    AppActions.app-info(root.app);
                    menu.close();
                }
            }
            if root.is-app && root.app.uninstallable: MenuItem {
                text: I18n.t("app_actions.uninstall");
                icon: @image-url("../icons/IoTrashOutline.svg");
                activated => {
                    AppActions.uninstall(root.app);
                    menu.close();
                }
            }
        }
    }
}
