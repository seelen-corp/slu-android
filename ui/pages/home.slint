import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Tokens } from "../tokens.slint";
import { HomeActions, Interaction, LauncherActions } from "../app-actions.slint";
import { AppsView, FolderItem, HomeItem, SwipeDownAction } from "../types.slint";
import { AppsLayout } from "../apps-layout.slint";
import { AppGridItem, GridLabelMetrics, GridMetrics } from "../components/app-grid.slint";
import { AppListItem, ListLabelMetrics, ListMetrics } from "../components/app-list-item.slint";
import { Button, ButtonSkin } from "../components/button.slint";
import { MenuSurface, MenuItem } from "../components/menu.slint";
import { WallpaperLabel } from "../components/wallpaper-label.slint";
import { FolderIcon } from "../components/folder-icon.slint";

// Long press on an empty part of Home (opens the Home menu).
component EmptySpaceTouch inherits TouchArea {
    // Window coordinates.
    callback long-pressed(x: length, y: length);

    private property <bool> moved-away: false;
    private property <bool> fired: false;

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            self.moved-away = false;
            self.fired = false;
        }
    }
    moved => {
        if abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px {
            self.moved-away = true;
        }
    }

    Timer {
        interval: 500ms;
        running: root.pressed && !root.moved-away && !root.fired;
        triggered => {
            root.fired = true;
            LauncherActions.haptic();
            root.long-pressed(root.absolute-position.x + root.pressed-x, root.absolute-position.y + root.pressed-y);
        }
    }
}



// Highlight of the cell/row an app would be dropped on (drop target outline).
component DropHighlight inherits Rectangle {
    border-radius: Tokens.radius-s;
    background: Tokens.slu-std-ui-selected-overlay;
    border-width: 2px;
    border-color: Tokens.system-accent-color;
}

// Page indicator: the current page is the wide dot.
component PageDots inherits Rectangle {
    in property <int> count: 1;
    in property <int> current: 0;

    property <length> dot: 6px;
    property <length> current-width: 16px;
    property <length> total-width: Math.max(0, root.count - 1) * (root.dot + Tokens.spacing-xs) + root.current-width;

    for index in root.count: Rectangle {
        x: (root.width - root.total-width) / 2 + index * (root.dot + Tokens.spacing-xs) + (index > root.current ? root.current-width - root.dot : 0);
        y: (root.height - root.dot) / 2;
        width: index == root.current ? root.current-width : root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: Tokens.wallpaper-fg-color;
    }
}

// Insertion point of a reorder in the list views (drop target indicator).
component DropLine inherits Rectangle {
    height: 2px;
    border-radius: 1px;
    background: Tokens.system-accent-color;
}

// Shared drag state of Home, in window coordinates. Bound two-way by the grid
// and list layouts. Dropping an app on another entry's icon (grid) or on the
// middle of its row (lists) puts them in a folder.
component HomeLayoutBase inherits Rectangle {
    in-out property <bool> dragging: false;
    in-out property <HomeItem> drag-item;
    in-out property <length> drag-x;
    in-out property <length> drag-y;

    callback empty-long-pressed(x: length, y: length);
    callback open-folder(folder: FolderItem);

    protected pure function same-entry(a: HomeItem, b: HomeItem) -> bool {
        return a.is-folder == b.is-folder && (a.is-folder
            ? a.folder.id == b.folder.id
            : a.app.package-name == b.app.package-name && a.app.activity-name == b.app.activity-name);
    }

    protected pure function is-dragged(item: HomeItem) -> bool {
        return root.dragging && root.same-entry(item, root.drag-item);
    }

    protected function start-drag(item: HomeItem, x: length, y: length) {
        root.drag-item = item;
        root.drag-x = x;
        root.drag-y = y;
        root.dragging = true;
    }
}

// Grid view: pages of cells (swiped horizontally) and the dock below them.
component HomeGrid inherits HomeLayoutBase {
    in property <[HomeItem]> items: [];
    in property <[HomeItem]> dock-items: [];
    in property <int> columns: 4;
    in property <int> page-count: 1;
    in-out property <int> current-page: 0;
    // Horizontal offset of the pages while the finger swipes them.
    in property <length> swipe-offset: 0;
    in property <bool> swiping: false;
    // Used cells, from Rust: `home-cells[(page * home-rows + row) * columns + col]`
    // and `dock-cells[col]`.
    in property <int> home-rows: 1;
    in property <[bool]> home-cells: [];
    in property <[bool]> dock-cells: [];

    // The rows that fit changed; Rust saves them and moves the apps that no
    // longer fit. Home is always portrait (manifest), so rotating doesn't change them.
    callback rows-fit(rows: int);

    // Cells a column wide and as tall as the icon (`AppsLayout.item-size`) plus
    // its label; as many rows as fit, the space left spread between them. The
    // dock uses the same columns and icon size, without labels.
    property <length> edge: AppsLayout.padding;
    property <length> inner-width: Math.max(0, root.width - 2 * root.edge);
    property <length> inner-height: Math.max(0, pages-area.height - 2 * root.edge);
    property <length> cell-width: GridMetrics.column-width(root.inner-width, root.columns);
    property <length> icon-size: GridMetrics.icon-size(root.cell-width);
    property <length> label-height: AppsLayout.label-lines * label-metrics.preferred-height;
    property <length> cell-height: GridMetrics.cell-height(root.icon-size, true, root.label-height);
    property <length> dock-cell-height: GridMetrics.cell-height(root.icon-size, false, 0);
    property <int> row-count: Math.max(1, Math.floor(root.inner-height / Math.max(1px, root.cell-height)));
    property <length> row-gap: root.row-count > 1 ? Math.max(0, (root.inner-height - root.row-count * root.cell-height) / (root.row-count - 1)) : 0;
    // Origin of the first cell, in window coordinates.
    property <length> pages-x: pages-area.absolute-position.x + root.edge;
    property <length> pages-y: pages-area.absolute-position.y + root.edge;
    property <bool> over-dock: root.dragging && root.drag-y >= dock-area.absolute-position.y;
    property <bool> over-grid: root.dragging && !root.over-dock;
    // Cell under the finger; half of the space around a cell counts as the cell.
    property <int> target-col: clamp(floor((root.drag-x - root.pages-x) / Math.max(1px, root.cell-width)), 0, root.columns - 1);
    property <int> target-row: clamp(floor((root.drag-y - root.pages-y + root.row-gap / 2) / Math.max(1px, root.cell-height + root.row-gap)), 0, root.row-count - 1);
    property <int> target-slot: clamp(floor((root.drag-x - dock-area.absolute-position.x - root.edge) / Math.max(1px, root.cell-width)), 0, root.columns - 1);

    // The finger is over the icon of the target cell/slot (not just its cell):
    // dropping there merges into a folder, anywhere else moves/swaps.
    property <length> icon-left: (root.cell-width - root.icon-size) / 2;
    property <length> in-cell-x: root.over-dock
        ? root.drag-x - dock-area.absolute-position.x - root.edge - root.target-slot * root.cell-width
        : root.drag-x - root.pages-x - root.target-col * root.cell-width;
    property <length> in-cell-y: root.over-dock
        ? root.drag-y - dock-area.absolute-position.y
        : root.drag-y - root.pages-y - root.target-row * (root.cell-height + root.row-gap);
    property <bool> over-icon: root.in-cell-x >= root.icon-left && root.in-cell-x <= root.icon-left + root.icon-size
        && root.in-cell-y >= GridMetrics.cell-padding && root.in-cell-y <= GridMetrics.cell-padding + root.icon-size;
    property <bool> target-used: root.over-dock
        ? root.dock-cells[root.target-slot]
        : root.target-row < root.home-rows && root.home-cells[(root.current-page * root.home-rows + root.target-row) * root.columns + root.target-col];
    // The dragged entry's own cell.
    property <bool> target-is-dragged: root.over-dock
        ? root.drag-item.dock && root.drag-item.col == root.target-slot
        : !root.drag-item.dock && root.drag-item.page == root.current-page && root.drag-item.col == root.target-col && root.drag-item.row == root.target-row;
    // Folders don't go into folders.
    property <bool> merging: root.dragging && !root.drag-item.is-folder && root.over-icon && root.target-used && !root.target-is-dragged;

    function report-rows() {
        // Not before the layout has a real size.
        if root.inner-height > 0 {
            root.rows-fit(root.row-count);
        }
    }

    changed row-count => { root.report-rows(); }
    init => { root.report-rows(); }

    // Dragging an app to a side edge flips the page.
    property <length> edge-zone: 24px;
    property <bool> at-left-edge: root.drag-x < root.pages-x + root.edge-zone;
    property <bool> at-right-edge: root.drag-x > root.pages-x + pages-area.width - root.edge-zone;

    function end-drag(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
        if root.over-dock {
            if root.merging {
                HomeActions.merge-into(root.drag-item, true, 0, root.target-slot, 0);
            } else {
                HomeActions.move-to(root.drag-item, true, 0, root.target-slot, 0);
            }
        } else if root.merging {
            HomeActions.merge-into(root.drag-item, false, root.current-page, root.target-col, root.target-row);
        } else {
            HomeActions.move-to(root.drag-item, false, root.current-page, root.target-col, root.target-row);
        }
        root.dragging = false;
    }

    EmptySpaceTouch {
        long-pressed(x, y) => { root.empty-long-pressed(x, y); }
    }

    label-metrics := GridLabelMetrics { }

    Timer {
        interval: 700ms;
        running: root.over-grid && (root.at-left-edge || root.at-right-edge);
        triggered => {
            if root.at-left-edge && root.current-page > 0 {
                root.current-page -= 1;
            } else if root.at-right-edge && root.current-page < root.page-count - 1 {
                root.current-page += 1;
            }
        }
    }

    VerticalLayout {
        pages-area := Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.items.length == 0 && root.dock-items.length == 0 && !root.dragging: VerticalLayout {
                padding: Tokens.spacing-xl;
                alignment: center;

                WallpaperLabel {
                    text: I18n.t("home.empty");
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.over-grid && !root.merging: DropHighlight {
                x: root.edge + root.target-col * root.cell-width;
                y: root.edge + root.target-row * (root.cell-height + root.row-gap);
                width: root.cell-width;
                height: root.cell-height;
            }

            // Merge target: around the icon only.
            if root.over-grid && root.merging: DropHighlight {
                x: root.edge + root.target-col * root.cell-width + root.icon-left - GridMetrics.cell-padding;
                y: root.edge + root.target-row * (root.cell-height + root.row-gap);
                width: root.icon-size + 2 * GridMetrics.cell-padding;
                height: root.icon-size + 2 * GridMetrics.cell-padding;
            }

            Rectangle {
                x: -root.current-page * pages-area.width + root.swipe-offset;
                width: pages-area.width * root.page-count;
                height: pages-area.height;
                // Page change (control state change); none while following the finger.
                animate x {
                    duration: root.swiping ? 0ms : 200ms;
                    easing: ease-out;
                }

                for item in root.items: AppGridItem {
                    x: item.page * pages-area.width + root.edge + item.col * root.cell-width;
                    y: root.edge + item.row * (root.cell-height + root.row-gap);
                    width: root.cell-width;
                    height: root.cell-height;
                    icon-size: root.icon-size;
                    label-height: root.label-height;
                    app: item.app;
                    is-folder: item.is-folder;
                    folder: item.folder;
                    on-home: true;
                    home-enabled: true;
                    draggable: true;
                    content-hidden: root.is-dragged(item);
                    open-folder => { root.open-folder(item.folder); }
                    drag-started(x, y) => { root.start-drag(item, x, y); }
                    drag-moved(x, y) => {
                        root.drag-x = x;
                        root.drag-y = y;
                    }
                    drag-ended(x, y) => { root.end-drag(x, y); }
                }
            }
        }

        PageDots {
            height: 24px;
            count: root.page-count;
            current: root.current-page;
            visible: root.page-count > 1;
        }

        // Same columns and side padding as the pages; the bottom padding too.
        dock-area := Rectangle {
            height: root.dock-cell-height + root.edge;

            if root.over-dock && !root.merging: DropHighlight {
                x: root.edge + root.target-slot * root.cell-width;
                y: 0;
                width: root.cell-width;
                height: root.dock-cell-height;
            }

            if root.over-dock && root.merging: DropHighlight {
                x: root.edge + root.target-slot * root.cell-width + root.icon-left - GridMetrics.cell-padding;
                y: 0;
                width: root.icon-size + 2 * GridMetrics.cell-padding;
                height: root.dock-cell-height;
            }

            for item in root.dock-items: AppGridItem {
                x: root.edge + item.col * root.cell-width;
                y: 0;
                width: root.cell-width;
                height: root.dock-cell-height;
                icon-size: root.icon-size;
                app: item.app;
                is-folder: item.is-folder;
                folder: item.folder;
                show-label: false;
                on-home: true;
                home-enabled: true;
                draggable: true;
                content-hidden: root.is-dragged(item);
                open-folder => { root.open-folder(item.folder); }
                drag-started(x, y) => { root.start-drag(item, x, y); }
                drag-moved(x, y) => {
                    root.drag-x = x;
                    root.drag-y = y;
                }
                drag-ended(x, y) => { root.end-drag(x, y); }
            }
        }
    }
}

// List views: every Home app in one scrollable list, reordered by dragging.
// Swipe up (when the list doesn't scroll) opens the Apps Menu, swipe down (at the
// top) the Swipe down action of Settings.
component HomeList inherits HomeLayoutBase {
    in property <[HomeItem]> items: [];
    in property <bool> show-icon: true;
    in property <length> swipe-distance: 48px;

    callback open-apps-menu(focus-search: bool);
    // Swipe down at the top (the action depends on Settings).
    callback swiped-down();

    // Row height (Settings: item size and label lines) and padding.
    list-metrics := ListLabelMetrics { }
    property <length> row-height: ListMetrics.row-height(list-metrics.preferred-height);
    property <length> edge: AppsLayout.padding;
    property <length> content-height: 2 * root.edge + root.items.length * root.row-height;
    // Finger position, in rows from the top of the list.
    property <float> drag-rows: (root.drag-y - scroll.absolute-position.y - scroll.viewport-y - root.edge) / Math.max(1px, root.row-height);
    property <int> hover-index: floor(root.drag-rows);
    // The middle half of another entry's row merges into a folder (folders
    // don't go into folders); anywhere else inserts between rows.
    property <bool> merging: root.dragging && !root.drag-item.is-folder
        && root.hover-index >= 0 && root.hover-index < root.items.length
        && root.drag-rows - root.hover-index >= 0.25 && root.drag-rows - root.hover-index <= 0.75
        && !root.same-entry(root.items[root.hover-index], root.drag-item);
    property <int> insert-index: clamp(round(root.drag-rows), 0, root.items.length);

    function end-drag(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
        if root.merging {
            let target = root.items[root.hover-index];
            HomeActions.merge-into(root.drag-item, target.dock, target.page, target.col, target.row);
        } else {
            HomeActions.move-to-index(root.drag-item, root.insert-index);
        }
        root.dragging = false;
    }

    SwipeGestureHandler {
        enabled: !Interaction.item-lifted && !root.dragging;
        handle-swipe-up: scroll.viewport-height <= scroll.visible-height;
        handle-swipe-down: scroll.viewport-y >= 0;
        swiped => {
            let dy = self.current-position.y - self.pressed-position.y;
            if dy <= -root.swipe-distance {
                root.open-apps-menu(false);
            } else if dy >= root.swipe-distance {
                root.swiped-down();
            }
        }

        VerticalLayout {
            scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                viewport-height: Math.max(root.content-height, self.visible-height);

                EmptySpaceTouch {
                    width: scroll.visible-width;
                    height: scroll.viewport-height;
                    long-pressed(x, y) => { root.empty-long-pressed(x, y); }
                }

                if root.items.length == 0: VerticalLayout {
                    width: scroll.visible-width;
                    height: scroll.visible-height;
                    padding: Tokens.spacing-xl;
                    alignment: center;

                    WallpaperLabel {
                        text: I18n.t("home.empty_list");
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.merging: DropHighlight {
                    x: root.edge;
                    y: root.edge + root.hover-index * root.row-height;
                    width: Math.max(0, scroll.visible-width - 2 * root.edge);
                    height: root.row-height;
                }

                if root.dragging && !root.merging: DropLine {
                    x: root.edge;
                    y: root.edge + root.insert-index * root.row-height - self.height / 2;
                    width: Math.max(0, scroll.visible-width - 2 * root.edge);
                }

                for item[index] in root.items: AppListItem {
                    x: root.edge;
                    y: root.edge + index * root.row-height;
                    width: Math.max(0, scroll.visible-width - 2 * root.edge);
                    height: root.row-height;
                    app: item.app;
                    is-folder: item.is-folder;
                    folder: item.folder;
                    show-icon: root.show-icon;
                    on-home: true;
                    home-enabled: true;
                    draggable: true;
                    content-hidden: root.is-dragged(item);
                    open-folder => { root.open-folder(item.folder); }
                    drag-started(x, y) => { root.start-drag(item, x, y); }
                    drag-moved(x, y) => {
                        root.drag-x = x;
                        root.drag-y = y;
                    }
                    drag-ended(x, y) => { root.end-drag(x, y); }
                }
            }

            HorizontalLayout {
                alignment: center;
                padding: Tokens.spacing-xs;

                Button {
                    text: I18n.t("home.all_apps");
                    skin: ButtonSkin.transparent;
                    over-wallpaper: true;
                    clicked => { root.open-apps-menu(false); }
                }
            }
        }
    }
}

// Home: the apps placed by the user, over the wallpaper. Grid view: pages + dock,
// swipe left/right between pages, up for the Apps Menu, down for the Settings action
// (search or notifications).
// List views: one list. Long press an app to move it (drag) or open its menu;
// long press an empty space for the Home menu.
export component HomePage inherits Rectangle {
    // Grid view.
    in property <[HomeItem]> items: [];
    in property <[HomeItem]> dock-items: [];
    in property <int> columns: 4;
    in property <int> pages: 1;
    // Used cells of the grid and dock (see `HomeGrid`).
    in property <int> rows: 1;
    in property <[bool]> cells: [];
    in property <[bool]> dock-cells: [];
    // List views: every Home entry (apps and folders), in order.
    in property <[HomeItem]> list-items: [];
    in property <AppsView> view: AppsView.grid;
    in property <SwipeDownAction> swipe-down-action: SwipeDownAction.search;
    in property <length> top-inset: 0px;
    in property <length> bottom-inset: 0px;
    in property <length> left-inset: 0px;
    in property <length> right-inset: 0px;
    in-out property <int> current-page: 0;

    callback open-apps-menu(focus-search: bool);
    // A folder was tapped.
    callback open-folder(folder: FolderItem);

    // Abort a drag in progress (e.g. the launcher went to the background).
    public function cancel-drag() {
        root.dragging = false;
        Interaction.item-lifted = false;
        root.clamp-page();
    }

    public function go-to-first-page() {
        root.current-page = 0;
    }

    property <bool> grid: root.view == AppsView.grid;
    property <bool> dragging: false;
    property <HomeItem> drag-item;
    property <length> drag-x;
    property <length> drag-y;
    // While dragging there's one more (empty) page, to move an app to a new page.
    property <int> page-count: root.dragging ? root.pages + 1 : root.pages;

    property <length> swipe-offset: 0;
    // Axis of the current swipe: 0 none yet, 1 horizontal, 2 vertical.
    property <int> swipe-axis: 0;
    // Minimum vertical swipe to open the Apps Menu / search.
    property <length> swipe-distance: 48px;

    // Size of the dragged icon: the same as in the view (see AppGridItem, AppListItem).
    property <length> drag-icon-size: root.grid
        ? GridMetrics.icon-size(GridMetrics.column-width(root.width - root.left-inset - root.right-inset - 2 * AppsLayout.padding, root.columns))
        : ListMetrics.icon-size();

    property <length> menu-x;
    property <length> menu-y;

    function clamp-page() {
        if root.current-page >= root.page-count {
            root.current-page = Math.max(0, root.page-count - 1);
        }
    }

    // Swipe down on Home: search (the Apps Menu with its search focused) or the
    // notifications panel, as chosen in Settings.
    function swipe-down() {
        if root.swipe-down-action == SwipeDownAction.notifications {
            LauncherActions.expand-notifications();
        } else {
            root.open-apps-menu(true);
        }
    }

    function show-menu(x: length, y: length) {
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        home-menu.show();
    }

    changed pages => { root.clamp-page(); }
    changed dragging => {
        if !root.dragging {
            root.clamp-page();
        }
    }

    swipe := SwipeGestureHandler {
        // Grid view only (HomeList has its own). An app being pressed/dragged owns
        // the touch.
        enabled: root.grid && !Interaction.item-lifted && !root.dragging;
        handle-swipe-left: true;
        handle-swipe-right: true;
        handle-swipe-up: true;
        handle-swipe-down: true;

        property <length> dx: self.current-position.x - self.pressed-position.x;
        property <length> dy: self.current-position.y - self.pressed-position.y;

        moved => {
            if !self.swiping {
                return;
            }
            if root.swipe-axis == 0 {
                root.swipe-axis = abs(self.dx) > abs(self.dy) ? 1 : 2;
            }
            if root.swipe-axis == 1 {
                // Resistance past the first/last page.
                let past-edge = (self.dx > 0 && root.current-page == 0) || (self.dx < 0 && root.current-page >= root.page-count - 1);
                root.swipe-offset = past-edge ? self.dx / 4 : self.dx;
            }
        }
        swiped => {
            if root.swipe-axis == 1 {
                if self.dx < -root.width / 5 && root.current-page < root.page-count - 1 {
                    root.current-page += 1;
                } else if self.dx > root.width / 5 && root.current-page > 0 {
                    root.current-page -= 1;
                }
            } else if root.swipe-axis == 2 {
                if self.dy <= -root.swipe-distance {
                    root.open-apps-menu(false);
                } else if self.dy >= root.swipe-distance {
                    root.swipe-down();
                }
            }
            root.swipe-offset = 0;
            root.swipe-axis = 0;
        }
        cancelled => {
            root.swipe-offset = 0;
            root.swipe-axis = 0;
        }

        VerticalLayout {
            padding-top: root.top-inset + Tokens.spacing-xs;
            padding-bottom: root.bottom-inset;
            padding-left: root.left-inset;
            padding-right: root.right-inset;
            spacing: Tokens.spacing-xs;

            if root.grid: HomeGrid {
                vertical-stretch: 1;
                items: root.items;
                dock-items: root.dock-items;
                columns: root.columns;
                home-rows: root.rows;
                home-cells: root.cells;
                dock-cells: root.dock-cells;
                rows-fit(rows) => { HomeActions.rows-fit(rows); }
                page-count: root.page-count;
                current-page <=> root.current-page;
                swipe-offset: root.swipe-offset;
                swiping: swipe.swiping;
                dragging <=> root.dragging;
                drag-item <=> root.drag-item;
                drag-x <=> root.drag-x;
                drag-y <=> root.drag-y;
                empty-long-pressed(x, y) => { root.show-menu(x, y); }
                open-folder(folder) => { root.open-folder(folder); }
            }

            if !root.grid: HomeList {
                vertical-stretch: 1;
                items: root.list-items;
                swipe-distance: root.swipe-distance;
                show-icon: root.view == AppsView.list;
                dragging <=> root.dragging;
                drag-item <=> root.drag-item;
                drag-x <=> root.drag-x;
                drag-y <=> root.drag-y;
                empty-long-pressed(x, y) => { root.show-menu(x, y); }
                open-folder(folder) => { root.open-folder(folder); }
                swiped-down => { root.swipe-down(); }
                open-apps-menu(focus-search) => { root.open-apps-menu(focus-search); }
            }
        }
    }

    // The entry being dragged, under the finger.
    if root.dragging: Rectangle {
        width: Math.max(96px, AppsLayout.item-size);
        height: Math.max(96px, AppsLayout.item-size);
        x: root.drag-x - root.absolute-position.x - self.width / 2;
        y: root.drag-y - root.absolute-position.y - self.height / 2;

        VerticalLayout {
            alignment: center;
            spacing: Tokens.spacing-2xs;

            HorizontalLayout {
                alignment: center;

                if !root.drag-item.is-folder: Image {
                    source: root.drag-item.app.icon;
                    width: root.drag-icon-size;
                    height: root.drag-icon-size;
                }
                if root.drag-item.is-folder: FolderIcon {
                    apps: root.drag-item.folder.apps;
                    width: root.drag-icon-size;
                    height: root.drag-icon-size;
                }
            }

            WallpaperLabel {
                text: !root.drag-item.is-folder ? root.drag-item.app.title
                    : root.drag-item.folder.title != "" ? root.drag-item.folder.title : I18n.t("home.folder");
                font-size: GridMetrics.label-font-size;
                horizontal-alignment: center;
                wrap: AppsLayout.label-lines > 1 ? TextWrap.word-wrap : TextWrap.no-wrap;
            }
        }
    }

    home-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;

        MenuSurface {
            min-width: 200px;

            MenuItem {
                text: I18n.t("home.wallpaper");
                activated => {
                    LauncherActions.open-wallpaper-picker();
                    home-menu.close();
                }
            }
            MenuItem {
                text: I18n.t("home.open_settings");
                activated => {
                    LauncherActions.open-settings();
                    home-menu.close();
                }
            }
        }
    }
}
