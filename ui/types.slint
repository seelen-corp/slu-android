// Data shared between Rust and the UI.

export struct AppItem {
    title: string,
    // Empty in the text-list view (icons are not loaded).
    icon: image,
    package-name: string,
    activity-name: string,
    // False for system apps.
    uninstallable: bool,
    // On Home (grid or dock).
    pinned: bool,
}

// Several apps in one slot of Home (`config::Folder`).
export struct FolderItem {
    id: int,
    // Set by the user; empty shows `home.folder`.
    title: string,
    // Installed apps only, in order.
    apps: [AppItem],
}

// An app or folder placed on Home: a cell of a grid page, or a slot of the
// dock. In the list views, the same entries in list order.
export struct HomeItem {
    is-folder: bool,
    // When not `is-folder`.
    app: AppItem,
    // When `is-folder`.
    folder: FolderItem,
    dock: bool,
    // Grid page (ignored in the dock).
    page: int,
    // Grid column, or dock slot.
    col: int,
    // Grid row (ignored in the dock).
    row: int,
}

// Settings > Launcher screens.
export enum LauncherScreens {
    // A single screen listing every app.
    apps-menu,
    // Home (apps placed by the user) + Apps Menu.
    home-and-apps-menu,
}

// Settings > Apps view: how apps are shown on Home and in the Apps Menu.
export enum AppsView {
    // Rows with icon and title.
    list,
    // Rows with the title only.
    text-list,
    // Icons with the title below.
    grid,
}

// Settings > Icon shape (`config::IconShape`).
export enum IconShape {
    // The device's own icon mask.
    system,
    circle,
    squircle,
    teardrop,
    // Corners set by Settings > Corner radius.
    rounded-square,
}

// Settings > Old-style icons (`config::LegacyIcons`): icons that are a single
// image, not adaptive.
export enum LegacyIcons {
    // Wrapped in the icon shape.
    wrap,
    // Drawn as they are.
    original,
}

// Settings > Swipe down on Home.
export enum SwipeDownAction {
    // The Apps Menu with its search focused.
    search,
    // The system notifications panel.
    notifications,
}
