import { Tokens } from "../tokens.slint";
import { AppsLayout } from "../apps-layout.slint";
import { AppItem } from "../types.slint";
import { AppItemBase } from "app-item-base.slint";
import { WallpaperLabel } from "wallpaper-label.slint";

export global GridMetrics {
    out property <relative-font-size> label-font-size: 0.875rem;
    // Padding between a cell's pressed overlay and its icon/label.
    out property <length> cell-padding: Tokens.spacing-2xs;
    // Smallest icon, whatever the column width.
    out property <length> min-icon-size: 16px;

    // Width of one of `columns` columns across `width`. Cells take the whole
    // column (so the label has room); the icon is centered in it.
    public pure function column-width(width: length, columns: int) -> length {
        return Math.max(0, width / Math.max(1, columns));
    }
    // Icon side: `AppsLayout.item-size` (the setting), smaller only if it doesn't
    // fit in the column. The same with or without label.
    public pure function icon-size(column-width: length) -> length {
        return Math.max(GridMetrics.min-icon-size, Math.min(AppsLayout.item-size, column-width - 2 * GridMetrics.cell-padding));
    }
    // Cell height for that icon: the label (`AppsLayout.label-lines` lines, always
    // reserved) adds its own space below.
    public pure function cell-height(icon-size: length, show-label: bool, label-height: length) -> length {
        return icon-size + 2 * GridMetrics.cell-padding + (show-label ? Tokens.spacing-2xs + label-height : 0);
    }
}

// Icon with the title below, centered in its cell. The icon has the size given
// by the grid (`GridMetrics.icon-size`); the label takes its own space below it.
// Drawn over the wallpaper.
export component AppGridItem inherits AppItemBase {
    // Hides the visuals but keeps the touch alive (the app is being dragged).
    in property <bool> content-hidden: false;
    in property <bool> show-label: true;
    in property <length> icon-size: AppsLayout.item-size;
    // Height reserved for the label (`AppsLayout.label-lines` lines).
    in property <length> label-height;

    Rectangle {
        border-radius: Tokens.radius-s;
        background: root.pressed ? Tokens.slu-std-ui-pressed-overlay : transparent;
        visible: !root.content-hidden;

        VerticalLayout {
            padding: GridMetrics.cell-padding;
            spacing: Tokens.spacing-2xs;
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Image {
                    source: root.app.icon;
                    width: root.icon-size;
                    height: root.icon-size;
                }
            }

            if root.show-label: WallpaperLabel {
                height: root.label-height;
                text: root.app.title;
                font-size: GridMetrics.label-font-size;
                horizontal-alignment: center;
                vertical-alignment: top;
                wrap: AppsLayout.label-lines > 1 ? TextWrap.word-wrap : TextWrap.no-wrap;
            }
        }
    }
}

// Measures the height of one grid label line.
export component GridLabelMetrics inherits Text {
    text: "Ag";
    font-size: GridMetrics.label-font-size;
    visible: false;
    accessible-role: none;
}

// Apps Menu grid: `columns` columns across the width; each cell is a column wide
// and as tall as the icon (`AppsLayout.item-size`) plus its label. Rows are
// separated by `AppsLayout.padding`. Its preferred height is the height of all
// its rows (it doesn't scroll by itself).
export component AppGrid inherits Rectangle {
    in property <[AppItem]> apps: [];
    in property <bool> home-enabled: false;
    in property <int> columns: 4;

    property <length> edge: AppsLayout.padding;
    property <length> inner-width: Math.max(0, self.width - 2 * self.edge);
    property <length> cell-width: GridMetrics.column-width(self.inner-width, self.columns);
    property <length> icon-size: GridMetrics.icon-size(self.cell-width);
    property <length> label-height: AppsLayout.label-lines * label-metrics.preferred-height;
    property <length> cell-height: GridMetrics.cell-height(self.icon-size, true, self.label-height);
    property <length> row-gap: AppsLayout.padding;
    property <int> row-count: Math.ceil(self.apps.length / self.columns);

    preferred-height: 2 * self.edge + self.row-count * self.cell-height + Math.max(0, self.row-count - 1) * self.row-gap;

    label-metrics := GridLabelMetrics { }

    for app[index] in root.apps: AppGridItem {
        x: root.edge + Math.mod(index, root.columns) * root.cell-width;
        y: root.edge + Math.floor(index / root.columns) * (root.cell-height + root.row-gap);
        width: root.cell-width;
        height: root.cell-height;
        icon-size: root.icon-size;
        label-height: root.label-height;
        app: app;
        home-enabled: root.home-enabled;
    }
}
