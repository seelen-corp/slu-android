import { HomePage } from "pages/home.slint";
import { AppsMenuPage } from "pages/apps-menu.slint";
import { ConfigPage } from "pages/config.slint";
import { FolderPage } from "pages/folder.slint";
import { Tokens } from "tokens.slint";
import { AppItem, FolderItem, HomeItem, PictureItem, LauncherScreens, AppsView, SwipeDownAction, IconShape, LegacyIcons, BadgePosition } from "types.slint";
import { HomeActions, Interaction, LauncherActions } from "app-actions.slint";

export { I18n } from "i18n.slint";
export { AppActions, HomeActions, LauncherActions } from "app-actions.slint";
export { Tokens }
export { AppsLayout } from "apps-layout.slint";
export { AppItem, FolderItem, HomeItem, PictureItem, LauncherScreens, AppsView, SwipeDownAction, IconShape, LegacyIcons, BadgePosition }

export component MainWindow inherits Window {
    in property <LauncherScreens> launcher-screens: LauncherScreens.apps-menu;
    in property <AppsView> apps-view: AppsView.list;
    in property <SwipeDownAction> swipe-down-action: SwipeDownAction.search;
    // Launchable apps shown in the Apps Menu (filtered by its search).
    in property <[AppItem]> apps: [];
    // Home, grid view: apps in the pages and in the dock, pictures in the pages.
    in property <[HomeItem]> home-items: [];
    in property <[HomeItem]> home-pictures: [];
    in property <[HomeItem]> dock-items: [];
    in property <int> home-columns: 4;
    in property <int> home-pages: 1;
    // Home, grid view: used cells, `home-cells[(page * home-rows + row) * columns + col]`
    // (0 free, 1 app or folder, 2 picture, 3+ a large folder) and `dock-cells[col]` (where a drop
    // can make a folder).
    in property <int> home-rows: 1;
    in property <[int]> home-cells: [];
    in property <[bool]> dock-cells: [];
    // Home, list views: every Home entry (apps and folders), in order.
    in property <[HomeItem]> home-list: [];
    // The folder view: shown over Home while `folder-open`. Rust keeps the
    // folder up to date, and closes the view if the folder is gone.
    in-out property <bool> folder-open: false;
    in-out property <FolderItem> open-folder;

    // The system wallpaper is drawn behind the window (wallpaper theme).
    background: transparent;

    private property <bool> home-enabled: root.launcher-screens == LauncherScreens.home-and-apps-menu;
    // Only meaningful with Home enabled; without it the Apps Menu is the only screen.
    private property <bool> apps-menu-open: false;
    private property <bool> focus-search-on-open: false;
    // The Apps Menu or a folder is shown: the wallpaper is behind the scrim.
    private property <bool> dimmed: !root.home-enabled || root.apps-menu-open || root.folder-open;

    changed dimmed => {
        Tokens.wallpaper-dimmed = self.dimmed;
        LauncherActions.wallpaper-dimmed-changed();
    }
    init => { Tokens.wallpaper-dimmed = self.dimmed; }

    // Back to Home (e.g. when the launcher is resumed after opening an app).
    public function show-home() {
        if root.apps-menu-open {
            LauncherActions.search("");
        }
        root.apps-menu-open = false;
        root.close-folder();
        home.cancel-drag();
        key-handler.focus();
    }

    // The Home button was pressed while the launcher was already in front: close
    // the Apps Menu or the folder, or go back to the first page.
    public function home-pressed() {
        if Interaction.resizing-picture {
            Interaction.resizing-picture = false;
        } else if root.apps-menu-open || root.folder-open {
            root.show-home();
        } else {
            home.go-to-first-page();
        }
    }

    function show-folder(folder: FolderItem) {
        root.open-folder = folder;
        root.folder-open = true;
        folder-page.reset();
        HomeActions.folder-shown(folder.id);
    }

    // Saves the title being edited first.
    function close-folder() {
        if root.folder-open {
            folder-page.commit-title();
            root.folder-open = false;
            HomeActions.folder-shown(-1);
            key-handler.focus();
        }
    }

    function open-apps-menu(focus-search: bool) {
        LauncherActions.search("");
        root.focus-search-on-open = focus-search;
        root.apps-menu-open = true;
        // Otherwise the Apps Menu focuses its search itself (`init`).
        if !focus-search {
            key-handler.focus();
        }
    }

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Back {
                if Interaction.resizing-picture {
                    Interaction.resizing-picture = false;
                } else if root.home-enabled && (root.apps-menu-open || root.folder-open) {
                    root.show-home();
                }
                // Consumed even on Home: the launcher is never closed by Back.
                return accept;
            }
            reject
        }

        // Scrim over the wallpaper, behind the Apps Menu / folder.
        if root.dimmed: Rectangle {
            background: Tokens.scrim-color;
        }

        // Kept alive while the Apps Menu or a folder is open (keeps its page), but hidden.
        home := HomePage {
            visible: root.home-enabled && !root.apps-menu-open && !root.folder-open;
            items: root.home-items;
            pictures: root.home-pictures;
            dock-items: root.dock-items;
            columns: root.home-columns;
            pages: root.home-pages;
            rows: root.home-rows;
            cells: root.home-cells;
            dock-cells: root.dock-cells;
            list-items: root.home-list;
            open-folder(folder) => { root.show-folder(folder); }
            view: root.apps-view;
            swipe-down-action: root.swipe-down-action;
            top-inset: root.safe-area-insets.top;
            bottom-inset: root.safe-area-insets.bottom;
            left-inset: root.safe-area-insets.left;
            right-inset: root.safe-area-insets.right;
            open-apps-menu(focus-search) => { root.open-apps-menu(focus-search); }
        }

        // Always alive (its title input must be reachable to save it), hidden
        // while closed.
        folder-page := FolderPage {
            visible: root.home-enabled && root.folder-open && !root.apps-menu-open;
            folder: root.open-folder;
            view: root.apps-view;
            columns: root.home-columns;
            top-inset: root.safe-area-insets.top;
            bottom-inset: root.safe-area-insets.bottom;
            close => { root.show-home(); }
        }

        if !root.home-enabled || root.apps-menu-open: menu := AppsMenuPage {
            apps: root.apps;
            view: root.apps-view;
            columns: root.home-columns;
            home-enabled: root.home-enabled;
            top-inset: root.safe-area-insets.top;
            bottom-inset: root.safe-area-insets.bottom;
            close => { root.show-home(); }
            init => {
                if root.focus-search-on-open {
                    self.focus-search();
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    in property <LauncherScreens> launcher-screens: LauncherScreens.apps-menu;
    in property <AppsView> apps-view: AppsView.list;
    in property <SwipeDownAction> swipe-down-action: SwipeDownAction.search;
    in property <IconShape> icon-shape: IconShape.system;
    in property <int> icon-corner-radius: 25;
    in property <LegacyIcons> legacy-icons: LegacyIcons.wrap;
    in property <int> home-columns: 4;
    // Item size of the current view.
    in property <int> item-size: 80;
    in property <int> apps-padding: 8;
    in property <int> label-lines: 1;
    in property <BadgePosition> badge-position: BadgePosition.top-right;
    in property <bool> notification-access: false;

    callback launcher-screens-changed(value: LauncherScreens);
    callback apps-view-changed(value: AppsView);
    callback swipe-down-action-changed(value: SwipeDownAction);
    callback icon-shape-changed(value: IconShape);
    callback icon-corner-radius-changed(value: int);
    callback legacy-icons-changed(value: LegacyIcons);
    callback grid-columns-changed(columns: int);
    callback item-size-changed(value: int);
    callback apps-padding-changed(value: int);
    callback label-lines-changed(value: int);
    callback badge-position-changed(value: BadgePosition);
    callback open-notification-access();
    callback open-wallpaper-picker();
    callback open-default-launcher-settings();

    background: Tokens.slu-std-bg-color;

    ConfigPage {
        top-inset: root.safe-area-insets.top;
        bottom-inset: root.safe-area-insets.bottom;
        launcher-screens: root.launcher-screens;
        apps-view: root.apps-view;
        swipe-down-action: root.swipe-down-action;
        icon-shape: root.icon-shape;
        icon-corner-radius: root.icon-corner-radius;
        legacy-icons: root.legacy-icons;
        home-columns: root.home-columns;
        item-size: root.item-size;
        apps-padding: root.apps-padding;
        label-lines: root.label-lines;
        badge-position: root.badge-position;
        notification-access: root.notification-access;
        launcher-screens-changed(value) => { root.launcher-screens-changed(value); }
        apps-view-changed(value) => { root.apps-view-changed(value); }
        swipe-down-action-changed(value) => { root.swipe-down-action-changed(value); }
        icon-shape-changed(value) => { root.icon-shape-changed(value); }
        icon-corner-radius-changed(value) => { root.icon-corner-radius-changed(value); }
        legacy-icons-changed(value) => { root.legacy-icons-changed(value); }
        grid-columns-changed(columns) => { root.grid-columns-changed(columns); }
        item-size-changed(value) => { root.item-size-changed(value); }
        apps-padding-changed(value) => { root.apps-padding-changed(value); }
        label-lines-changed(value) => { root.label-lines-changed(value); }
        badge-position-changed(value) => { root.badge-position-changed(value); }
        open-notification-access => { root.open-notification-access(); }
        open-wallpaper-picker => { root.open-wallpaper-picker(); }
        open-default-launcher-settings => { root.open-default-launcher-settings(); }
    }
}
