import { Tokens } from "../tokens.slint";
import { AppItem } from "../types.slint";
import { AppItemBase } from "app-item-base.slint";
import { WallpaperLabel } from "wallpaper-label.slint";

// Same size Rust renders the icons at (`ICON_SIZE` in lib.rs).
export global GridMetrics {
    out property <length> icon-size: 48px;
    out property <relative-font-size> label-font-size: 0.875rem;
    // Minimum cell width of the Apps Menu grid; the free space is spread among
    // the columns.
    out property <length> min-cell-width: 80px;
}

// Icon with the title below, centered in its cell. Drawn over the wallpaper.
export component AppGridItem inherits AppItemBase {
    // Hides the visuals but keeps the touch alive (the app is being dragged).
    in property <bool> content-hidden: false;
    in property <bool> show-label: true;

    VerticalLayout {
        padding: Tokens.spacing-2xs;
        alignment: center;

        Rectangle {
            border-radius: Tokens.radius-s;
            background: root.pressed ? Tokens.slu-std-ui-pressed-overlay : transparent;
            visible: !root.content-hidden;

            VerticalLayout {
                padding: Tokens.spacing-2xs;
                spacing: Tokens.spacing-2xs;
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        source: root.app.icon;
                        width: GridMetrics.icon-size;
                        height: GridMetrics.icon-size;
                    }
                }

                if root.show-label: WallpaperLabel {
                    text: root.app.title;
                    font-size: GridMetrics.label-font-size;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// Apps laid out in rows of equally sized cells, as many columns as fit. Its
// preferred height is the height of all its rows (it doesn't scroll by itself).
export component AppGrid inherits Rectangle {
    in property <[AppItem]> apps: [];
    in property <bool> home-enabled: false;

    property <int> columns: Math.max(1, Math.floor(self.width / GridMetrics.min-cell-width));
    property <length> cell-width: self.width / self.columns;
    property <length> cell-height: GridMetrics.icon-size + 4 * Tokens.spacing-2xs + Tokens.spacing-2xs + label-metrics.preferred-height + Tokens.spacing-xs;

    preferred-height: Math.ceil(self.apps.length / self.columns) * self.cell-height;

    // Only measures the height of one label line.
    label-metrics := Text {
        text: "Ag";
        font-size: GridMetrics.label-font-size;
        visible: false;
        accessible-role: none;
    }

    for app[index] in root.apps: AppGridItem {
        x: Math.mod(index, root.columns) * root.cell-width;
        y: Math.floor(index / root.columns) * root.cell-height;
        width: root.cell-width;
        height: root.cell-height;
        app: app;
        home-enabled: root.home-enabled;
    }
}
