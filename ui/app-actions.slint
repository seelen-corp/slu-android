import { AppItem, HomeItem, PictureItem, WidgetProviderItem } from "types.slint";

// Actions on an app, implemented in Rust. Called by every app entry (list row,
// grid cell, Home cell) wherever it is shown.
export global AppActions {
    callback launch(app: AppItem);
    callback add-to-home(app: AppItem);
    // Also from the folder it's in.
    callback remove-from-home(app: AppItem);
    // Out of its folder, to the first free cell of Home.
    callback remove-from-folder(app: AppItem);
    callback app-info(app: AppItem);
    callback uninstall(app: AppItem);
}

// Home layout edits, implemented in Rust. Entries (apps or folders) are given as
// the `HomeItem` the UI shows.
export global HomeActions {
    // Moves an entry of Home to a grid cell or dock slot. If another one is
    // there, both swap places.
    callback move-to(item: HomeItem, dock: bool, page: int, col: int, row: int);
    // Drops an entry on the one in a grid cell or dock slot: an app dropped on
    // an app makes a folder with both; on a folder, it joins it. Otherwise
    // (a folder dropped, an empty slot) the same as `move-to`.
    callback merge-into(item: HomeItem, dock: bool, page: int, col: int, row: int);
    // List views: moves an entry right before the one at `index` of the list
    // (the length puts it last); the others shift, keeping the cells the layout
    // uses.
    callback move-to-index(item: HomeItem, index: int);
    // Grid view, portrait: the number of rows that fit on screen changed (the
    // item size or the screen). Rust saves it and moves apps that no longer fit.
    callback rows-fit(rows: int);
    // The folder view opened (Rust keeps it up to date) or closed (-1).
    callback folder-shown(id: int);
    callback rename-folder(id: int, title: string);
    // Removes a folder; its apps go back to Home (the first one in its place).
    callback disband-folder(id: int);
    // Whether a folder of the grid can be enlarged to 2x2 cells (`large`; the
    // apps in the way move to free cells) or shrunk back to one.
    pure callback can-resize-folder(id: int, large: bool) -> bool;
    callback resize-folder(id: int, large: bool);
    // Whether `move-to` would move the entry there (its cells fit in the grid,
    // and no picture is on them).
    pure callback can-move(item: HomeItem, dock: bool, page: int, col: int, row: int) -> bool;
    // Opens the system image picker; the image goes to that grid cell if it's
    // free, otherwise to the first free one.
    callback add-picture(page: int, col: int, row: int);
    // Removes a picture from Home (and its copy of the image), or a widget.
    callback remove-picture(picture: PictureItem);
    // Whether a picture or widget can cover `columns` x `rows` cells from its
    // own: they fit in the grid and nothing else is on them.
    pure callback can-resize-picture(picture: PictureItem, columns: int, rows: int) -> bool;
    callback resize-picture(picture: PictureItem, columns: int, rows: int);
    // Grid view: the size of a cell (the space between rows apart) and the
    // padding around what's drawn in it, for the default size of new widgets.
    callback grid-metrics(cell-width: length, cell-height: length, row-gap: length, inset: length);
    // Opens the widget picker (Rust loads the providers); the widget goes to
    // that grid cell if its cells are free, otherwise to the first free area.
    callback open-widget-picker(page: int, col: int, row: int);
    // A provider was picked: Rust binds the widget (the system may ask the user
    // to allow it, and the widget may show its settings first), then adds it.
    callback add-widget(provider: WidgetProviderItem);
    // A widget is drawn `width` x `height` big (its frames follow that size).
    callback widget-size(id: int, width: length, height: length);
    // A touch on a widget, forwarded to it: `action` is a `MotionEvent` action
    // (0 down, 1 up, 2 move, 3 cancel), at a position of the widget.
    callback widget-touch(id: int, action: int, x: length, y: length);
}

// Launcher/system actions, implemented in Rust.
export global LauncherActions {
    callback open-settings();
    callback open-wallpaper-picker();
    callback expand-notifications();
    // Short haptic tick (e.g. when a long press is recognized).
    callback haptic();
    // Apps Menu search; Rust filters the apps shown.
    callback search(query: string);
    // `Tokens.wallpaper-dimmed` changed: Rust updates the system bar icons.
    callback wallpaper-dimmed-changed();
}

// Touch interaction state shared by the app entries and the gesture handlers
// around them.
export global Interaction {
    // An app entry recognized a long press and owns the touch until it's
    // released: the page/Apps Menu swipe gestures must not take it over.
    in-out property <bool> item-lifted: false;
    // A picture of Home is being resized (its handles own the touch); cleared to
    // leave that mode (tap elsewhere, Back, Home).
    in-out property <bool> resizing-picture: false;
    // A widget of Home is being touched: vertical swipes are its own (e.g. to
    // scroll its list), not Home's.
    in-out property <bool> widget-pressed: false;
}
