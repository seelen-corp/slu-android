import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Tokens } from "../tokens.slint";
import { LauncherScreens, AppsView, SwipeDownAction, IconShape, LegacyIcons, BadgePosition } from "../types.slint";
import { Button, ButtonSkin } from "../components/button.slint";
import { Select } from "../components/select.slint";
import { Slider } from "../components/slider.slint";

// A setting: label on the left, its control (the child) on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;

    spacing: Tokens.spacing-s;

    Text {
        text: root.label;
        font-size: 1rem;
        color: root.enabled ? Tokens.slu-std-fg-color : Tokens.slu-std-fg-disabled-color;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }

    @children
}

// A setting set with a slider: label and current value on top, slider below.
component SliderSetting inherits VerticalLayout {
    in property <string> label;
    in property <string> unit;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> value: 0;

    callback changed(value: int);

    spacing: Tokens.spacing-2xs;

    HorizontalLayout {
        spacing: Tokens.spacing-s;

        Text {
            text: root.label;
            font-size: 1rem;
            color: Tokens.slu-std-fg-color;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        Text {
            text: "\{slider.current-value} \{root.unit}";
            font-size: 1rem;
            color: Tokens.slu-std-fg-secondary-color;
            vertical-alignment: center;
        }
    }

    slider := Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value;
        changed(value) => { root.changed(value); }
    }
}

// Section title.
component SectionTitle inherits Text {
    font-size: 0.875rem;
    font-weight: 600;
    color: Tokens.slu-std-fg-secondary-color;
}

export component ConfigPage inherits Rectangle {
    in property <length> top-inset: 0px;
    in property <length> bottom-inset: 0px;
    in property <LauncherScreens> launcher-screens: LauncherScreens.apps-menu;
    in property <AppsView> apps-view: AppsView.list;
    in property <SwipeDownAction> swipe-down-action: SwipeDownAction.search;
    in property <IconShape> icon-shape: IconShape.system;
    // Percent of the icon side (`ICON_CORNER_RADIUS_RANGE` in config.rs).
    in property <int> icon-corner-radius: 25;
    in property <LegacyIcons> legacy-icons: LegacyIcons.wrap;
    in property <int> home-columns: 4;
    // Logical px. The item size is the one of the current view.
    in property <int> item-size: 80;
    in property <int> apps-padding: 8;
    // Lines of the app titles (`LABEL_LINES_RANGE` in config.rs).
    in property <int> label-lines: 1;
    in property <BadgePosition> badge-position: BadgePosition.top-right;
    // The launcher may read the notifications (needed by the badges).
    in property <bool> notification-access: false;

    callback launcher-screens-changed(value: LauncherScreens);
    callback apps-view-changed(value: AppsView);
    callback swipe-down-action-changed(value: SwipeDownAction);
    callback icon-shape-changed(value: IconShape);
    callback icon-corner-radius-changed(value: int);
    callback legacy-icons-changed(value: LegacyIcons);
    callback grid-columns-changed(columns: int);
    callback item-size-changed(value: int);
    callback apps-padding-changed(value: int);
    callback label-lines-changed(value: int);
    callback badge-position-changed(value: BadgePosition);
    callback open-notification-access();
    callback open-wallpaper-picker();
    callback open-default-launcher-settings();
    // Opens a link of Settings > About in the browser.
    callback open-url(url: string);

    // Choices of Settings > Grid columns.
    property <[int]> column-choices: [3, 4, 5, 6];
    // Choices of Settings > Icon shape, in the order of its options.
    property <[IconShape]> icon-shape-choices: [
        IconShape.system,
        IconShape.circle,
        IconShape.squircle,
        IconShape.teardrop,
        IconShape.rounded-square,
    ];
    // Choices of Settings > Notification badges, in the order of its options.
    property <[BadgePosition]> badge-position-choices: [
        BadgePosition.off,
        BadgePosition.top-left,
        BadgePosition.top-right,
        BadgePosition.bottom-left,
        BadgePosition.bottom-right,
    ];
    // Item size range of the current view (`AppsView::item_size_range` in config.rs).
    property <int> item-size-min: root.apps-view == AppsView.grid ? 32 : root.apps-view == AppsView.list ? 40 : 32;
    property <int> item-size-max: root.apps-view == AppsView.grid ? 96 : root.apps-view == AppsView.list ? 120 : 96;

    background: Tokens.slu-std-bg-color;

    ScrollView {
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            padding: Tokens.spacing-m;
            padding-top: root.top-inset + Tokens.spacing-m;
            padding-bottom: root.bottom-inset + Tokens.spacing-m;
            spacing: Tokens.spacing-m;
            alignment: start;

            Text {
                text: I18n.t("settings.title");
                font-size: 1.5rem;
                font-weight: 600;
                color: Tokens.slu-std-fg-color;
            }

            SectionTitle {
                text: I18n.t("settings.section_layout");
            }

            SettingRow {
                label: I18n.t("settings.launcher_screens");

                // Same order as the `LauncherScreens` enum.
                Select {
                    options: [
                        I18n.t("settings.launcher_screens_apps_menu"),
                        I18n.t("settings.launcher_screens_home_and_apps_menu"),
                    ];
                    current-index: root.launcher-screens == LauncherScreens.apps-menu ? 0 : 1;
                    selected(index) => {
                        root.launcher-screens-changed(index == 0 ? LauncherScreens.apps-menu : LauncherScreens.home-and-apps-menu);
                    }
                }
            }

            SettingRow {
                label: I18n.t("settings.apps_view");

                // Same order as the `AppsView` enum.
                Select {
                    options: [
                        I18n.t("settings.apps_view_list"),
                        I18n.t("settings.apps_view_text_list"),
                        I18n.t("settings.apps_view_grid"),
                    ];
                    current-index: root.apps-view == AppsView.list ? 0 : root.apps-view == AppsView.text-list ? 1 : 2;
                    selected(index) => {
                        root.apps-view-changed(index == 0 ? AppsView.list : index == 1 ? AppsView.text-list : AppsView.grid);
                    }
                }
            }

            // Only Home has the gesture.
            if root.launcher-screens == LauncherScreens.home-and-apps-menu: SettingRow {
                label: I18n.t("settings.swipe_down");

                // Same order as the `SwipeDownAction` enum.
                Select {
                    options: [
                        I18n.t("settings.swipe_down_search"),
                        I18n.t("settings.swipe_down_notifications"),
                    ];
                    current-index: root.swipe-down-action == SwipeDownAction.search ? 0 : 1;
                    selected(index) => {
                        root.swipe-down-action-changed(index == 0 ? SwipeDownAction.search : SwipeDownAction.notifications);
                    }
                }
            }

            // Grid view: Home and the Apps Menu.
            if root.apps-view == AppsView.grid: SettingRow {
                label: I18n.t("settings.grid_columns");

                Select {
                    options: ["3", "4", "5", "6"];
                    current-index: Math.max(0, root.home-columns - 3);
                    selected(index) => { root.grid-columns-changed(root.column-choices[index]); }
                }
            }

            SectionTitle {
                text: I18n.t("settings.section_apps");
            }

            // The text list shows no icons.
            if root.apps-view != AppsView.text-list: SettingRow {
                label: I18n.t("settings.icon_shape");

                // Same order as `icon-shape-choices`.
                Select {
                    options: [
                        I18n.t("settings.icon_shape_system"),
                        I18n.t("settings.icon_shape_circle"),
                        I18n.t("settings.icon_shape_squircle"),
                        I18n.t("settings.icon_shape_teardrop"),
                        I18n.t("settings.icon_shape_rounded_square"),
                    ];
                    current-index: root.icon-shape == IconShape.circle ? 1
                        : root.icon-shape == IconShape.squircle ? 2
                        : root.icon-shape == IconShape.teardrop ? 3
                        : root.icon-shape == IconShape.rounded-square ? 4
                        : 0;
                    selected(index) => { root.icon-shape-changed(root.icon-shape-choices[index]); }
                }
            }

            if root.apps-view != AppsView.text-list && root.icon-shape == IconShape.rounded-square: SliderSetting {
                label: I18n.t("settings.icon_corner_radius");
                unit: I18n.t("settings.unit_percent");
                minimum: 0;
                maximum: 50;
                value: root.icon-corner-radius;
                changed(value) => { root.icon-corner-radius-changed(value); }
            }

            if root.apps-view != AppsView.text-list: SettingRow {
                label: I18n.t("settings.legacy_icons");

                // Same order as the `LegacyIcons` enum.
                Select {
                    options: [
                        I18n.t("settings.legacy_icons_wrap"),
                        I18n.t("settings.legacy_icons_original"),
                    ];
                    current-index: root.legacy-icons == LegacyIcons.wrap ? 0 : 1;
                    selected(index) => {
                        root.legacy-icons-changed(index == 0 ? LegacyIcons.wrap : LegacyIcons.original);
                    }
                }
            }

            SliderSetting {
                label: I18n.t("settings.item_size");
                unit: I18n.t("settings.unit_px");
                minimum: root.item-size-min;
                maximum: root.item-size-max;
                value: root.item-size;
                changed(value) => { root.item-size-changed(value); }
            }

            SettingRow {
                label: I18n.t("settings.label_lines");

                // Index = lines - 1.
                Select {
                    options: [
                        I18n.t("settings.label_lines_one"),
                        I18n.t("settings.label_lines_two"),
                    ];
                    current-index: root.label-lines - 1;
                    selected(index) => {
                        root.label-lines-changed(index + 1);
                    }
                }
            }

            // Range of `APPS_PADDING_RANGE` (config.rs).
            SliderSetting {
                label: I18n.t("settings.apps_padding");
                unit: I18n.t("settings.unit_px");
                minimum: 0;
                maximum: 60;
                value: root.apps-padding;
                changed(value) => { root.apps-padding-changed(value); }
            }

            // Only Home shows the badges.
            if root.launcher-screens == LauncherScreens.home-and-apps-menu: SettingRow {
                label: I18n.t("settings.badges");

                // Same order as `badge-position-choices`.
                Select {
                    options: [
                        I18n.t("settings.badges_off"),
                        I18n.t("settings.badges_top_left"),
                        I18n.t("settings.badges_top_right"),
                        I18n.t("settings.badges_bottom_left"),
                        I18n.t("settings.badges_bottom_right"),
                    ];
                    current-index: root.badge-position == BadgePosition.top-left ? 1
                        : root.badge-position == BadgePosition.top-right ? 2
                        : root.badge-position == BadgePosition.bottom-left ? 3
                        : root.badge-position == BadgePosition.bottom-right ? 4
                        : 0;
                    selected(index) => { root.badge-position-changed(root.badge-position-choices[index]); }
                }
            }

            if root.launcher-screens == LauncherScreens.home-and-apps-menu && root.badge-position != BadgePosition.off: VerticalLayout {
                spacing: Tokens.spacing-2xs;

                SettingRow {
                    label: I18n.t("settings.notification_access");

                    Button {
                        text: root.notification-access ? I18n.t("settings.change") : I18n.t("settings.allow");
                        clicked => { root.open-notification-access(); }
                    }
                }

                if !root.notification-access: Text {
                    text: I18n.t("settings.notification_access_hint");
                    font-size: 0.875rem;
                    color: Tokens.slu-std-fg-secondary-color;
                    wrap: word-wrap;
                }
            }

            SectionTitle {
                text: I18n.t("settings.section_system");
            }

            SettingRow {
                label: I18n.t("settings.wallpaper");

                Button {
                    text: I18n.t("settings.change");
                    clicked => { root.open-wallpaper-picker(); }
                }
            }

            SettingRow {
                label: I18n.t("settings.default_launcher");

                Button {
                    text: I18n.t("settings.change");
                    clicked => { root.open-default-launcher-settings(); }
                }
            }

            SectionTitle {
                text: I18n.t("settings.section_about");
            }

            SettingRow {
                label: I18n.t("settings.github");

                Button {
                    text: I18n.t("settings.open");
                    icon: @image-url("../icons/IoLogoGithub.svg");
                    clicked => { root.open-url("https://github.com/seelen-corp/slu-android"); }
                }
            }

            SettingRow {
                label: I18n.t("settings.website");

                Button {
                    text: I18n.t("settings.open");
                    icon: @image-url("../icons/IoGlobeOutline.svg");
                    clicked => { root.open-url("https://seelen.io"); }
                }
            }

            SettingRow {
                label: I18n.t("settings.discord");

                Button {
                    text: I18n.t("settings.open");
                    icon: @image-url("../icons/IoLogoDiscord.svg");
                    clicked => { root.open-url("https://discord.seelen.io"); }
                }
            }
        }
    }
}
