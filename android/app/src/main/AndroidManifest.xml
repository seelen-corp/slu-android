<?xml version="1.0" encoding="utf-8"?>
<!--
  package, versionCode/versionName, minSdk/targetSdk now live in
  app/build.gradle.kts (standard AGP convention) instead of here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Package visibility (API 30+): without this, PackageManager hides most
    other apps from queryIntentActivities/queryIntentActivities results
    (Settings, Dialer, YouTube, etc. all get silently filtered out), even
    though this app is a launcher. This <queries> block is what actually
    grants visibility into every other launchable app.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    Required (API 28+) to start the system uninstall dialog with
    Intent.ACTION_DELETE (see system-modules/apps.rs::uninstall).
  -->
  <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

  <!--
    Swipe down on Home opens the notification shade
    (StatusBarManager.expandNotificationsPanel, see system-modules/system.rs).
  -->
  <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

  <application
    android:label="Seelen UI Launcher"
    android:icon="@mipmap/ic_launcher">
    <!--
      HomeActivity (a thin android.app.NativeActivity subclass, see
      SluNativeActivity): loads our native library (android:value below)
      via JNI and forwards the Activity lifecycle to it. Almost all app
      logic is Rust; SluNativeActivity/PackageChangeReceiver are the only
      Java sources, needed for things Rust can't safely do itself (status
      bar icon contrast, and BroadcastReceiver registration, which
      requires a real Java/Dalvik object).
    -->
    <!--
      Wallpaper theme: the system draws the wallpaper behind the window, and
      HomeActivity makes its surface translucent so it shows through the
      (transparent) Slint UI. singleTask: pressing Home while the launcher is
      in front delivers onNewIntent instead of a new instance. Always
      portrait: in landscape Home keeps the same layout and sizes, rotated.
    -->
    <activity
      android:name=".HomeActivity"
      android:exported="true"
      android:label="Seelen UI Launcher"
      android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar"
      android:launchMode="singleTask"
      android:stateNotNeeded="true"
      android:clearTaskOnLaunch="true"
      android:windowSoftInputMode="adjustNothing"
      android:screenOrientation="portrait"
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode">
      <meta-data
        android:name="android.app.lib_name"
        android:value="slu_launcher" />

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      Settings screen. No HOME/LAUNCHER category, so it is never the
      default activity and never shows up as an app icon: it can only be
      reached via an explicit startActivity from within this app.
      Because it's a regular (non-HOME) activity, it appears as its own
      entry in the Recents/multitasking view.

      Runs in its own process: Slint only allows one platform
      (`slint::android::init`) per process, and the Home activity's
      process has already set one. Without `android:process`, opening
      Settings would fail to init a second platform in-process and the
      activity would come up blank and unresponsive (no event loop ever
      starts, so even Back does nothing).

      A distinct `taskAffinity` (plus FLAG_ACTIVITY_NEW_TASK on the
      launching Intent, see activity::open_settings) is what actually
      makes it its own entry in Recents/multitasking — process alone
      doesn't affect tasks; without this it gets pushed onto Home's
      existing task instead of starting a new one.
    -->
    <activity
      android:name=".SettingsActivity"
      android:process=":settings"
      android:taskAffinity="com.seelen.slu_launcher.settings"
      android:exported="false"
      android:label="Settings"
      android:configChanges="orientation|keyboardHidden|screenSize|uiMode">
      <meta-data
        android:name="android.app.lib_name"
        android:value="slu_launcher" />
    </activity>

    <!--
      Notification badges of the apps on Home (system-modules/badges.rs).
      The system binds it only after the user allows the launcher's
      notification access; it runs in the Home process (no android:process),
      where the counts are shown.
    -->
    <service
      android:name=".NotificationBadgeService"
      android:label="Seelen UI Launcher"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action
          android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
