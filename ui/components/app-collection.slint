import { ListView, ScrollView } from "std-widgets.slint";
import { AppItem, AppsView } from "../types.slint";
import { AppsLayout } from "../apps-layout.slint";
import { AppListItem } from "app-list-item.slint";
import { AppGrid } from "app-grid.slint";

// The Apps Menu's apps, in the view chosen in Settings (list, text list or grid),
// scrollable, with the item size and padding of `AppsLayout`.
export component AppCollection inherits Rectangle {
    in property <[AppItem]> apps: [];
    in property <AppsView> view: AppsView.list;
    in property <bool> home-enabled: false;
    // Grid view.
    in property <int> columns: 4;
    // Scrolled to the very top (a swipe down there is free for the parent).
    out property <bool> at-top: self.scroll-y >= 0;

    // The viewport-y of the list/grid (0 at the top, negative when scrolled).
    property <length> scroll-y: 0;

    public function scroll-to-top() {
        self.scroll-y = 0;
    }

    vertical-stretch: 1;

    // `mouse-drag-pan-enabled`: Slint's ScrollView/ListView ignore drags by
    // default, and that includes touch: without it they only scroll with a wheel.
    if root.view != AppsView.grid: ListView {
        width: root.width;
        height: root.height;
        mouse-drag-pan-enabled: true;
        viewport-y <=> root.scroll-y;

        // Padding of `AppsLayout` around the rows (keeps the ListView's lazy
        // rows): the first row adds the top padding, the last the bottom one.
        for app[index] in root.apps: VerticalLayout {
            padding-left: AppsLayout.padding;
            padding-right: AppsLayout.padding;
            padding-top: index == 0 ? AppsLayout.padding : 0;
            padding-bottom: index == root.apps.length - 1 ? AppsLayout.padding : 0;

            AppListItem {
                app: app;
                show-icon: root.view == AppsView.list;
                home-enabled: root.home-enabled;
            }
        }
    }

    if root.view == AppsView.grid: scroll := ScrollView {
        width: root.width;
        height: root.height;
        mouse-drag-pan-enabled: true;
        viewport-height: grid.preferred-height;
        viewport-y <=> root.scroll-y;

        grid := AppGrid {
            width: scroll.visible-width;
            apps: root.apps;
            home-enabled: root.home-enabled;
            columns: root.columns;
        }
    }
}
